# Copy to .env and adjust. .env is gitignored.

# --- AWS ---
AWS_REGION=eu-central-1
# Credentials are NOT set here. They come from the standard boto3 provider chain
# (SSO profile, env vars, or instance role). See README.
# AWS_PROFILE=your-sso-profile-name

# --- Persistence ---
DYNAMODB_TABLE_NAME=networks
# Point at DynamoDB Local for offline development. Unset it to use real DynamoDB.
DYNAMODB_ENDPOINT_URL=http://localhost:8001
# Create the table on first use. Local development only — in AWS the table is
# managed by Terraform and the runtime role cannot create tables.
AUTO_CREATE_TABLE=true

# --- Auth ---
# Dev-only default. Generate a real one: openssl rand -hex 32
JWT_SECRET=dev-only-insecure-secret-change-me-before-deploying
ACCESS_TOKEN_TTL_MINUTES=60

# Seeded demo user, so a reviewer can obtain a token immediately.
DEMO_USERNAME=demo
DEMO_PASSWORD=demo-password
